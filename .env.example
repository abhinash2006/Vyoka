# ==============================================================================
# Vyoka Labs Private Limited — Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development or set these in your
# hosting platform (e.g. Vercel, AWS Amplify, Docker, Railway).
#
# Note: In development mode, if RESEND_API_KEY or SMTP credentials are not provided,
# the contact submission endpoint runs in safe DEV MODE: submissions are validated,
# logged clearly to the server console, and return an honest status message without
# discarding user submissions.
# ==============================================================================

# Site URL (used for canonical URLs and Open Graph tags)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Verified Company Contact Address (used in footer & email notifications)
NEXT_PUBLIC_COMPANY_EMAIL=contact@vyokalabs.com
NEXT_PUBLIC_COMPANY_LOCATION="Bengaluru, Karnataka, India"

# Contact Form Email Dispatch Configuration
# Option 1: Resend (Recommended)
RESEND_API_KEY=
CONTACT_NOTIFICATION_EMAIL=enquiries@vyokalabs.com

# Option 2: SMTP Relay (Alternative)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Vyoka Labs Contact Form <noreply@vyokalabs.com>"
